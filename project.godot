[application]
config/name="UZ LIFE RP"
run/main_scene="res://Main.tscn"
[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
[network]
limits/max_network_packet_size=65536
[input]
forward={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":87)]}
back={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":83)]}
left={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":65)]}
right={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":68)]}
[rendering]

textures/default_filters/use_nearest_mipmap_filter=false
textures/vram_compression/import_etc2_astc=true
